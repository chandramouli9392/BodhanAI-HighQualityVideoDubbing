# Bodhan AI Hosted API Configuration
BODHAN_API_BASE_URL=https://api.bodhan.ai/v1

# Bodhan Service API Keys
BODHAN_TRANSCRIBE_API_KEY=your_bodhan_transcribe_api_key_here
